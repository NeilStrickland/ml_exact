<Group labelreference="L15" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">gru := proc(h,x)
 local l,m,r,z,zc,lh,mh,hh;
 m := [op(1..p,h)];
 l := [op(p+1..2*p,h)];
 r := x;
 z := [(1-max(1-x,0)) $ p,op(map(max,m -~ max(1-x,0),0))];
 zc := -~(z -~ 1);
 lh := l +~ r *~ m;
 mh := [0,op(1..-2,m)];
 hh := [op(mh), op(lh)];
 return(z *~ hh +~ zc *~ h);
end:</Text-field>
</Input>
</Group>
