<Group hide-input="false" labelreference="L4" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">p := 6;</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LV9JLFR5cGVzZXR0aW5nRzYkJSpwcm90ZWN0ZWRHSShfc3lzbGliRzYiSSxtcHJpbnRzbGFzaEdGKDYkNyM+SSJwR0YoIiInNyNGLg==</Equation></Text-field>
</Output>
</Group>
<Group labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">f0 := (x::list) -&gt; map(u -&gt; `if`(u&gt;0,1,0), x):
</Text-field>
</Input>
</Group>
<Group labelreference="L2" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">f1 := proc(x::list)
 local i,j;
 [seq(add(x[j],j=1..i),i=1..nops(x))];
end:

f2 := proc(x::list)
 local i,A;
 A := Matrix(nops(x),p+1);
 for i from 1 to nops(x) do 
  A[i,x[i]+1] := 1;
 od:
 return convert(A,listlist);
end:

g0 := proc(x::list)
 local i,y,z;
 y := f0(x);
 z := f2(f1(y));
 return([seq([y[i],op(z[i])],i=1..nops(x))]);
end:

f3 := proc(x)
 local i,j;
 [seq([seq(max(0,x[i][j]+x[i][1]-1),j=2..p+2)],i=1..nops(x))]
end:

g1 := proc(x)
 local i,y;
 y := f3(g0(x));
 [seq([x[i],op(y[i])],i=1..nops(x))]
end:

f4 := proc(u)
 local n,a,x,v,w,i,j;
 n := nops(u);
 a := [seq(u[i][1],i=1..n)];
 x := [seq([op(2..-1,u[i])],i=1..n)];
 v := [[a[1],0$(p-1)]];
 for i from 2 to n do 
  w := [seq(`if`(x[i][j+1]=1,a[i],v[-1][j]),j=1..p)];
  v := [op(v),w];
 od:
 return v;
end:

g2 := proc(x)
 f4(g1(x))[-1];
end:</Text-field>
</Input>
</Group>
